/* =========================================================
   TubeRip – Dark Cyber-Cyan Theme
   Matches the application UI mockup exactly.
   Primary: #11eef9 (Cyber Cyan)
   ========================================================= */

/* ── Global ─────────────────────────────────────────────── */
QMainWindow, QWidget {
    background-color: #111113;
    color: #e4e4e7;
    font-family: "Inter", "Segoe UI", Ubuntu, sans-serif;
    font-size: 13px;
}

/* ── Title Bar ──────────────────────────────────────────── */
QWidget#titleBar {
    background-color: #0d0d0f;
    border-bottom: 1px solid #1f1f23;
}

QLabel#logoBox {
    background-color: #11eef9;
    color: #0c0c0e;
    font-weight: 800;
    font-size: 11px;
    border-radius: 5px;
    padding: 2px 6px;
}

QLabel#appName {
    color: #ffffff;
    font-weight: 700;
    font-size: 15px;
}

QPushButton#titleBarBtn {
    background: transparent;
    border: none;
    color: #71717a;
    font-size: 15px;
    padding: 0;
}

QPushButton#titleBarBtn:hover {
    color: #e4e4e7;
}

QPushButton#closeBtn {
    background: transparent;
    border: none;
    color: #71717a;
    font-size: 13px;
}
QPushButton#closeBtn:hover { color: #ef4444; }
QPushButton#minBtn:hover   { color: #eab308; }
QPushButton#maxBtn:hover   { color: #22c55e; }

/* ── Separator line ─────────────────────────────────────── */
QFrame#separator {
    background-color: #1f1f23;
    max-width: 1px;
}

/* ── Section labels ─────────────────────────────────────── */
QLabel#sectionTitle {
    color: #ffffff;
    font-size: 18px;
    font-weight: 700;
}
QLabel#sectionSubtitle {
    color: #52525b;
    font-size: 12px;
}
QLabel#inputLabel {
    color: #71717a;
    font-size: 11px;
    font-weight: 500;
}

/* ── URL Input ──────────────────────────────────────────── */
QLineEdit#urlInput {
    background-color: #18181b;
    border: 1.5px solid #2d2d31;
    border-radius: 7px;
    padding: 9px 12px;
    color: #e4e4e7;
    font-size: 13px;
    selection-background-color: #11eef9;
    selection-color: #0c0c0e;
}
QLineEdit#urlInput:focus {
    border: 1.5px solid #11eef9;
}

/* ── ComboBoxes (Format, Quality) ───────────────────────── */
QComboBox {
    background-color: #18181b;
    border: 1.5px solid #2d2d31;
    border-radius: 7px;
    padding: 9px 12px;
    color: #e4e4e7;
    font-size: 13px;
    font-weight: 500;
}
QComboBox:hover  { border-color: #3f3f46; }
QComboBox:focus  { border-color: #11eef9; }
QComboBox::drop-down {
    border: none;
    width: 28px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
}
QComboBox QAbstractItemView {
    background-color: #1c1c1f;
    border: 1px solid #2d2d31;
    selection-background-color: #11eef9;
    selection-color: #0c0c0e;
    border-radius: 5px;
    padding: 4px;
}

/* ── Settings Gear Button ───────────────────────────────── */
QPushButton#settingsBtn {
    background-color: #18181b;
    border: 1.5px solid #2d2d31;
    border-radius: 7px;
    color: #a1a1aa;
    font-size: 15px;
    padding: 0;
}
QPushButton#settingsBtn:hover {
    border-color: #3f3f46;
    color: #e4e4e7;
}

/* ── Primary Download Button ────────────────────────────── */
QPushButton#downloadBtn {
    background-color: #11eef9;
    color: #0c0c0e;
    border: none;
    border-radius: 7px;
    font-weight: 700;
    font-size: 14px;
    padding: 10px 20px;
}
QPushButton#downloadBtn:hover   { background-color: #0dd4de; }
QPushButton#downloadBtn:pressed { background-color: #0aabb4; }

/* ── Save-to row ────────────────────────────────────────── */
QLabel#saveToLabel {
    color: #71717a;
    font-size: 12px;
}
QLabel#saveToPath {
    color: #a1a1aa;
    font-size: 12px;
}
QPushButton#folderBtn {
    background-color: transparent;
    border: none;
    color: #71717a;
    font-size: 18px;
    padding: 0;
}
QPushButton#folderBtn:hover { color: #e4e4e7; }

/* ── Download Queue List ────────────────────────────────── */
QListWidget {
    background-color: transparent;
    border: none;
    outline: none;
}
QListWidget::item {
    background-color: #18181b;
    border: 1px solid #27272a;
    border-radius: 8px;
    margin-bottom: 8px;
    padding: 0;
}
QListWidget::item:selected {
    background-color: #1c1c1f;
    border-color: #11eef9;
}
QListWidget::item:hover {
    border-color: #3f3f46;
}

/* ── Queue Item internal layout ─────────────────────────── */
QLabel#itemIndex {
    color: #52525b;
    font-size: 14px;
    font-weight: 700;
}
QLabel#itemTitle {
    color: #e4e4e7;
    font-size: 13px;
    font-weight: 500;
}
QLabel#itemMeta {
    color: #71717a;
    font-size: 11px;
}
QLabel#statusDownloading {
    color: #11eef9;
    font-size: 12px;
    font-weight: 600;
}
QLabel#statusCompleted {
    color: #22c55e;
    font-size: 12px;
    font-weight: 600;
}
QLabel#statusQueued {
    color: #eab308;
    font-size: 12px;
    font-weight: 600;
}
QLabel#statusPaused {
    color: #22c55e;
    font-size: 12px;
    font-weight: 600;
}
QLabel#statusCancelled {
    color: #71717a;
    font-size: 12px;
    font-weight: 600;
}
QLabel#statusError {
    color: #ef4444;
    font-size: 12px;
    font-weight: 600;
}
QLabel#statusDot {
    font-size: 10px;
}
QLabel#statusInfo {
    color: #71717a;
    font-size: 11px;
}

/* ── Progress Bar (inside queue items) ──────────────────── */
QProgressBar {
    background-color: #0c0c0e;
    border: none;
    border-radius: 3px;
    height: 5px;
    text-align: center;
}
QProgressBar::chunk {
    background-color: #11eef9;
    border-radius: 3px;
}

/* ── Item Action Buttons ────────────────────────────────── */
QPushButton#itemActionBtn {
    background-color: #27272a;
    border: 1px solid #3f3f46;
    border-radius: 6px;
    color: #a1a1aa;
    font-size: 11px;
    font-weight: 700;
    padding: 0;
}
QPushButton#itemActionBtn:hover {
    background-color: #3f3f46;
    color: #e4e4e7;
}

/* ── Settings Dialog ──────────────────────────────────── */
QDialog {
    background-color: #111113;
    color: #e4e4e7;
    border: 1px solid #27272a;
    border-radius: 10px;
}

QDialog QLabel {
    color: #e4e4e7;
}

QTextBrowser {
    background-color: #18181b;
    border: 1.5px solid #2d2d31;
    border-radius: 7px;
    padding: 12px;
    color: #e4e4e7;
    font-family: "Inter", "Segoe UI", Ubuntu, sans-serif;
    font-size: 13px;
    selection-background-color: #11eef9;
    selection-color: #0c0c0e;
}

QTextBrowser::item:selected {
    background-color: #11eef9;
    color: #0c0c0e;
}

QGroupBox {
    border: 1px solid #27272a;
    border-radius: 7px;
    margin-top: 12px;
    padding: 14px 12px 10px 12px;
    background-color: #18181b;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #71717a;
    font-size: 11px;
    font-weight: 600;
}

QCheckBox {
    color: #a1a1aa;
    spacing: 8px;
    font-size: 13px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1.5px solid #3f3f46;
    background-color: #18181b;
}

QCheckBox::indicator:checked {
    background-color: #11eef9;
    border-color: #11eef9;
}

QCheckBox:hover {
    color: #e4e4e7;
}

QSpinBox {
    background-color: #18181b;
    border: 1.5px solid #2d2d31;
    border-radius: 6px;
    padding: 6px 10px;
    color: #e4e4e7;
    font-size: 13px;
    min-width: 56px;
}

QSpinBox:focus {
    border-color: #11eef9;
}

QSlider::groove:horizontal {
    height: 4px;
    background-color: #27272a;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: #11eef9;
    border: none;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    margin: -5px 0;
}

QSlider::sub-page:horizontal {
    background-color: #11eef9;
    border-radius: 2px;
}

QDialogButtonBox QPushButton {
    padding: 8px 20px;
    min-width: 80px;
}

