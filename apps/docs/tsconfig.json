{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "inclusive",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": ".",
    "paths": {
      "@/*": ["./src/*"],
    },
    "types": ["vite/client"],
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  "references": [{ "path": "./tsconfig.node.json" }],
}
