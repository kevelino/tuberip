# TubeRip Flatpak (draft — post-MVP)

```json
{
  "app-id": "com.tuberip.TubeRip",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "desktop",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--filesystem=xdg-download",
    "--filesystem=xdg-config/firefox:ro",
    "--filesystem=xdg-config/google-chrome:ro",
    "--filesystem=xdg-config/chromium:ro"
  ],
  "modules": [
    {
      "name": "ffmpeg",
      "buildsystem": "simple",
      "build-commands": ["echo Use runtime ffmpeg or ship a module"],
      "sources": []
    },
    {
      "name": "yt-dlp",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 yt-dlp /app/bin/yt-dlp"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp",
          "dest-filename": "yt-dlp"
        }
      ]
    },
    {
      "name": "tuberip",
      "buildsystem": "simple",
      "build-commands": [
        "cp -r bundle/* /app/",
        "install -Dm644 tuberip.desktop /app/share/applications/com.tuberip.TubeRip.desktop",
        "install -Dm644 assets/icons/tuberip.svg /app/share/icons/hicolor/scalable/apps/tuberip.svg"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "build/linux/x64/release/bundle"
        }
      ]
    }
  ]
}
```

Replace the ffmpeg placeholder with a real module or Freedesktop extension before Flathub submission.
